# Local development can call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Recommended for production: omit NEXT_PUBLIC_API_URL and set this to the
# backend origin. Next.js will proxy same-origin /api/v1 requests to it.
# Example: API_PROXY_TARGET=https://api.example.com
API_PROXY_TARGET=
